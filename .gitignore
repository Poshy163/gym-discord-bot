# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Env / secrets
.env
# Encryption key for stored settings and linked Revo/Strava/Hevy credentials.
# Lives next to the database, so a local run puts it here. Never commit it —
# and back up the production one alongside /data, or those credentials are
# unrecoverable. See docs/CONFIG.md.
.secret_key

# Local data
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal
data/

# Production database dumps pulled down for local analysis (/db_dump output).
# Real member data - never commit these; the folder stays local by design.
dumps/

# Revo portal research scratch dumps (may contain personal account HTML)
scripts/_revo_probe_out/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

